# Copy to production.env only after obtaining your domain and database.
DOMAIN=shop.example.com
ACME_EMAIL=you@example.com
CLIENT_URL=https://shop.example.com
BACKEND_URL=https://shop.example.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/buildforge
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
PORT=5000

# Keep orders closed until stock/prices/photos, fulfillment and policies are real.
CHECKOUT_ENABLED=false
STORE_NAME=BuildForge
SUPPORT_EMAIL=
STORE_ADDRESS=
SHIPPING_POLICY=
RETURN_POLICY=

# Optional services. Credentials belong here, never in GitHub or frontend files.
GA_MEASUREMENT_ID=
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ESEWA_ENABLED=false
ESEWA_TEST_MODE=false
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
SHIPPING_PARTNER_EMAIL=
SHIPPING_PARTNER_WHATSAPP=
ESEWA_SWEEP_INTERVAL_MINUTES=30
# Enable only on your final domain, after verifying the catalog and policies.
SITE_INDEXABLE=false

# Optional owned HTTPS PNG/JPEG for social previews. SVG fallback is included.
SOCIAL_IMAGE_URL=

# Set actual delivery fees before opening checkout. 0 threshold means always free.
SHIPPING_FLAT_RATE_NPR=300
FREE_SHIPPING_THRESHOLD_NPR=100000
