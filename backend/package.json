{
  "name": "buildforge-backend",
  "version": "1.0.0",
  "description": "BuildForge \u2014 Custom PC Builder & E-Commerce Platform (Backend)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seedProducts.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=\"auth.test.js|integration.test.js\"",
    "admin:create": "node scripts/createAdmin.js",
    "launch:check": "node scripts/checkLaunch.js",
    "test:integration": "jest --runInBand tests/auth.test.js tests/catalog.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
