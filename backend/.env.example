PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/buildforge

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

GEMINI_API_KEY=

ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_TEST_MODE=true

# Publicly reachable URL of THIS backend — eSewa redirects the customer's
# browser to <BACKEND_URL>/api/orders/esewa/success|failure after payment.
# localhost is fine for local sandbox testing with eSewa's UAT environment;
# use a tunnel (ngrok, etc.) or your deployed URL for anything else.
BACKEND_URL=http://localhost:5000

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="BuildForge <no-reply@buildforge.com>"

SHIPPING_PARTNER_EMAIL=
SHIPPING_PARTNER_PHONE=
SHIPPING_PARTNER_WHATSAPP=

# Phase 9: periodic sweep for eSewa orders stuck Pending indefinitely (see
# backend/services/esewaSweepService.js). All optional — sane defaults apply
# if unset. Set ESEWA_SWEEP_INTERVAL_MINUTES=0 to disable the interval sweep
# entirely (the manual admin trigger, POST /api/admin/orders/sweep-esewa,
# still works regardless).
ESEWA_SWEEP_INTERVAL_MINUTES=30
ESEWA_SWEEP_RECHECK_AFTER_MINUTES=15
ESEWA_SWEEP_EXPIRE_AFTER_HOURS=24

CLIENT_URL=http://localhost:5173

# Phase 11: only set this to "true" if the backend is actually deployed
# behind a real reverse proxy/load balancer (nginx, a PaaS's edge, etc.).
# It makes Express trust the X-Forwarded-For header for rate-limiting and
# logging purposes — trusting it with no real proxy in front lets a client
# spoof its own IP and dodge the rate limiters. Leave unset for local dev.
TRUST_PROXY=
